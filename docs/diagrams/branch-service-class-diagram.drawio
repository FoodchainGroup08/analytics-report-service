        </mxCell>

        <mxCell id="DTOs" value="&lt;b&gt;DTOs (Records)&lt;/b&gt;&lt;hr&gt;BranchRequest&lt;br&gt;BranchResponse&lt;br&gt;BranchHoursRequest" style="text;html=1;strokeColor=#2E86C1;fillColor=#D6EAF8;align=left;verticalAlign=top;spacingLeft=4;rounded=1;fontSize=10;" vertex="1" parent="L1">
