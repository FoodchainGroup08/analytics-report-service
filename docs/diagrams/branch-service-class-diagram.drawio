<mxfile host="app.diagrams.net">
  <diagram name="Branch Service Class Diagram">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Branch Service — Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="800" height="45" as="geometry" />
        </mxCell>

        <!-- ═══ L1: Domain Layer ═══ -->
        <mxCell id="L1" value="Domain Layer  (JPA Entities)" style="swimlane;startSize=28;fillColor=#EBF5FB;strokeColor=#2E86C1;fontColor=#1A5276;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1560" height="235" as="geometry" />
        </mxCell>

        <mxCell id="Branch" value="&lt;b&gt;&lt;i&gt;@Entity&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Branch&lt;/b&gt;&lt;hr&gt;- id: String&lt;br&gt;- name: String&lt;br&gt;- address: String&lt;br&gt;- phone: String&lt;br&gt;- email: String&lt;br&gt;- active: boolean&lt;br&gt;- branchHours: List&lt;BranchHours&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="60" y="40" width="240" height="175" as="geometry" />
        </mxCell>

        <mxCell id="BranchHours" value="&lt;b&gt;&lt;i&gt;@Entity&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;BranchHours&lt;/b&gt;&lt;hr&gt;- id: String&lt;br&gt;- branch: Branch&lt;br&gt;- dayOfWeek: DayOfWeek&lt;br&gt;- openTime: LocalTime&lt;br&gt;- closeTime: LocalTime&lt;br&gt;- open: boolean" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="380" y="40" width="240" height="165" as="geometry" />
