        <mxCell id="BranchService" value="&lt;b&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;BranchService&lt;/b&gt;&lt;hr&gt;+ getAllBranches(): List&lt;br&gt;+ getBranchById(id): Branch&lt;br&gt;+ createBranch(dto): Branch&lt;br&gt;+ updateBranch(id, dto): Branch&lt;br&gt;+ deleteBranch(id): void&lt;br&gt;+ getBranchHours(branchId): List" style="text;html=1;strokeColor=#D4AC0D;fillColor=#FEFDE0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L2">
