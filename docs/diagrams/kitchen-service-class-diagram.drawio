<mxfile host="app.diagrams.net">
  <diagram name="Kitchen Service Class Diagram">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1350" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Kitchen Service — Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="800" height="45" as="geometry" />
        </mxCell>

        <!-- ═══ L1: Service Layer ═══ -->
        <mxCell id="L1" value="Service Layer  (Interfaces &amp; Implementations)" style="swimlane;startSize=28;fillColor=#FEFDE0;strokeColor=#D4AC0D;fontColor=#7D6608;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1560" height="245" as="geometry" />
        </mxCell>

        <mxCell id="KitchenQueueService" value="&lt;b&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;KitchenQueueService&lt;/b&gt;&lt;hr&gt;+ enqueueOrder(event): void&lt;br&gt;+ getQueue(): List&lt;KitchenOrderEvent&gt;&lt;br&gt;+ updateOrderStatus(orderId, status): void&lt;br&gt;+ removeOrder(orderId): void&lt;br&gt;+ getOrderById(orderId): KitchenOrderEvent" style="text;html=1;strokeColor=#D4AC0D;fillColor=#FEFDE0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="40" y="40" width="265" height="175" as="geometry" />
        </mxCell>

        <mxCell id="KitchenQueueServiceImpl" value="&lt;b&gt;KitchenQueueServiceImpl&lt;/b&gt;&lt;hr&gt;- redisTemplate: RedisTemplate&lt;String, Object&gt;&lt;br&gt;- QUEUE_KEY: String (constant)&lt;br&gt;+ enqueueOrder(event): void&lt;br&gt;+ getQueue(): List&lt;KitchenOrderEvent&gt;&lt;br&gt;+ updateOrderStatus(orderId, status): void&lt;br&gt;+ removeOrder(orderId): void&lt;br&gt;+ getOrderById(orderId): KitchenOrderEvent" style="text;html=1;strokeColor=#D4AC0D;fillColor=#FEFDE0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="355" y="35" width="285" height="195" as="geometry" />
        </mxCell>

        <mxCell id="SLAMonitoringService" value="&lt;b&gt;SLAMonitoringService&lt;/b&gt;&lt;hr&gt;- kitchenQueueService: KitchenQueueService&lt;br&gt;@Scheduled(fixedDelay=60000)&lt;br&gt;+ checkSlaBreaches(): void&lt;br&gt;+ getBreachedOrders(): List&lt;br&gt;&lt;i&gt;Alerts when orders exceed SLA time&lt;/i&gt;" style="text;html=1;strokeColor=#D4AC0D;fillColor=#FEFDE0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="690" y="40" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="e_impl" value="implements" style="dashed=1;endArrow=block;endFill=0;strokeColor=#D4AC0D;" edge="1" parent="L1" source="KitchenQueueServiceImpl" target="KitchenQueueService">
          <mxGeometry relative="1" as="geometry" />
