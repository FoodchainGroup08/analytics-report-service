        <mxCell id="e_sla" value="uses" style="dashed=1;endArrow=open;endFill=0;strokeColor=#D4AC0D;" edge="1" parent="L1" source="SLAMonitoringService" target="KitchenQueueService">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ L2: API Layer ═══ -->
        <mxCell id="L2" value="API Layer  (REST Controllers)" style="swimlane;startSize=28;fillColor=#EAFAF1;strokeColor=#1E8449;fontColor=#145A32;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="1560" height="185" as="geometry" />
        </mxCell>

        <mxCell id="KitchenController" value="&lt;b&gt;KitchenController&lt;/b&gt;&lt;hr&gt;- kitchenQueueService: KitchenQueueService&lt;br&gt;GET /api/kitchen/queue&lt;br&gt;GET /api/kitchen/orders/{orderId}&lt;br&gt;PUT /api/kitchen/orders/{orderId}/status&lt;br&gt;DELETE /api/kitchen/orders/{orderId}" style="text;html=1;strokeColor=#1E8449;fillColor=#EAFAF1;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L2">
