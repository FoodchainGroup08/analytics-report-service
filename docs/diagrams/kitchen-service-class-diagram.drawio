          <mxGeometry x="40" y="540" width="1560" height="185" as="geometry" />
        </mxCell>

        <mxCell id="KitchenEventConsumer" value="&lt;b&gt;KitchenEventConsumer&lt;/b&gt;&lt;hr&gt;- kitchenQueueService: KitchenQueueService&lt;br&gt;@KafkaListener(topics=&quot;kitchen.order.created&quot;)&lt;br&gt;+ consumeOrderCreated(event): void&lt;br&gt;@KafkaListener(topics=&quot;kitchen.order.updated&quot;)&lt;br&gt;+ consumeOrderUpdated(event): void" style="text;html=1;strokeColor=#D35400;fillColor=#FDEBD0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L3">
