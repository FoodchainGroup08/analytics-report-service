<mxfile host="app.diagrams.net">
  <diagram name="Security Architecture Class Diagram">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Security Architecture — Cross-Service Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="1000" height="45" as="geometry" />
        </mxCell>

        <!-- ═══ Zone A: API Gateway ═══ -->
        <mxCell id="ZA" value="API Gateway  (Spring Cloud Gateway — Reactive)" style="swimlane;startSize=28;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1560" height="220" as="geometry" />
        </mxCell>

        <mxCell id="GW_JwtAuthFilter" value="&lt;b&gt;JwtAuthFilter&lt;/b&gt;&lt;hr&gt;implements GlobalFilter, Ordered&lt;br&gt;- jwtSecret: String&lt;br&gt;+ filter(exchange, chain): Mono&lt;Void&gt;&lt;br&gt;+ getOrder(): int&lt;br&gt;- validateToken(token): Claims&lt;br&gt;- isExcluded(path): boolean&lt;br&gt;&lt;i&gt;Validates JWT before forwarding request&lt;/i&gt;" style="text;html=1;strokeColor=#666666;fillColor=#F5F5F5;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZA">
          <mxGeometry x="60" y="38" width="320" height="163" as="geometry" />
        </mxCell>

        <!-- ═══ Zone B: User Service Security ═══ -->
        <mxCell id="ZB" value="User Service  (Spring Security — Servlet)" style="swimlane;startSize=28;fillColor=#EBF5FB;strokeColor=#2E86C1;fontColor=#1A5276;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1560" height="700" as="geometry" />
        </mxCell>

        <!-- JWT Service -->
        <mxCell id="JwtService_if" value="&lt;b&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;JwtService&lt;/b&gt;&lt;hr&gt;+ generateToken(user): String&lt;br&gt;+ validateToken(token): boolean&lt;br&gt;+ extractUsername(token): String&lt;br&gt;+ extractClaims(token): Claims" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="40" y="40" width="240" height="145" as="geometry" />
        </mxCell>

        <mxCell id="JwtServiceImpl" value="&lt;b&gt;JwtServiceImpl&lt;/b&gt;&lt;hr&gt;- secretKey: String&lt;br&gt;- expirationMs: long&lt;br&gt;+ generateToken(user): String&lt;br&gt;+ validateToken(token): boolean&lt;br&gt;+ extractUsername(token): String&lt;br&gt;+ extractClaims(token): Claims" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="325" y="40" width="250" height="155" as="geometry" />
        </mxCell>

        <mxCell id="e_jwt_impl" value="implements" style="dashed=1;endArrow=block;endFill=0;strokeColor=#2E86C1;" edge="1" parent="ZB" source="JwtServiceImpl" target="JwtService_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Token Blacklist -->
        <mxCell id="TokenBlacklist_if" value="&lt;b&gt;&lt;i&gt;«interface»&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;TokenBlacklistService&lt;/b&gt;&lt;hr&gt;+ blacklist(token): void&lt;br&gt;+ isBlacklisted(token): boolean" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="640" y="40" width="240" height="115" as="geometry" />
        </mxCell>

        <mxCell id="TokenBlacklistImpl" value="&lt;b&gt;TokenBlacklistServiceImpl&lt;/b&gt;&lt;hr&gt;- redisTemplate: RedisTemplate&lt;String, String&gt;&lt;br&gt;- BLACKLIST_PREFIX: String&lt;br&gt;+ blacklist(token): void&lt;br&gt;  &lt;i&gt;stores in Redis with TTL = token expiry&lt;/i&gt;&lt;br&gt;+ isBlacklisted(token): boolean&lt;br&gt;  &lt;i&gt;checks Redis key existence&lt;/i&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="940" y="35" width="290" height="160" as="geometry" />
        </mxCell>

        <mxCell id="e_bl_impl" value="implements" style="dashed=1;endArrow=block;endFill=0;strokeColor=#2E86C1;" edge="1" parent="ZB" source="TokenBlacklistImpl" target="TokenBlacklist_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Filters -->
        <mxCell id="JwtAuthFilter_us" value="&lt;b&gt;JwtAuthenticationFilter&lt;/b&gt;&lt;hr&gt;extends OncePerRequestFilter&lt;br&gt;- jwtService: JwtService&lt;br&gt;- tokenBlacklistService: TokenBlacklistService&lt;br&gt;- userDetailsService: UserDetailsService&lt;br&gt;+ doFilterInternal(req, res, chain): void&lt;br&gt;&lt;i&gt;Sets SecurityContext after JWT validation&lt;/i&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="40" y="230" width="310" height="165" as="geometry" />
        </mxCell>

        <mxCell id="JwtAuthzFilter" value="&lt;b&gt;JwtAuthorizationFilter&lt;/b&gt;&lt;hr&gt;extends OncePerRequestFilter&lt;br&gt;- jwtService: JwtService&lt;br&gt;+ doFilterInternal(req, res, chain): void&lt;br&gt;&lt;i&gt;Checks roles/authorities for authorization&lt;/i&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="400" y="230" width="290" height="140" as="geometry" />
        </mxCell>

        <mxCell id="SecurityConfig" value="&lt;b&gt;SecurityConfig&lt;/b&gt;&lt;hr&gt;@Configuration, @EnableWebSecurity&lt;br&gt;- jwtAuthFilter: JwtAuthenticationFilter&lt;br&gt;- oAuth2UserService: CustomOAuth2UserService&lt;br&gt;- successHandler: OAuth2AuthenticationSuccessHandler&lt;br&gt;+ securityFilterChain(http): SecurityFilterChain&lt;br&gt;+ passwordEncoder(): BCryptPasswordEncoder" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="750" y="230" width="330" height="160" as="geometry" />
        </mxCell>

        <!-- OAuth2 -->
        <mxCell id="CustomOAuth2UserService" value="&lt;b&gt;CustomOAuth2UserService&lt;/b&gt;&lt;hr&gt;extends DefaultOAuth2UserService&lt;br&gt;- userRepository: UserRepository&lt;br&gt;+ loadUser(request): OAuth2User&lt;br&gt;&lt;i&gt;Registers/finds user from OAuth2 provider&lt;/i&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="40" y="450" width="300" height="145" as="geometry" />
        </mxCell>

        <mxCell id="OAuth2SuccessHandler" value="&lt;b&gt;OAuth2AuthenticationSuccessHandler&lt;/b&gt;&lt;hr&gt;extends SimpleUrlAuthenticationSuccessHandler&lt;br&gt;- jwtService: JwtService&lt;br&gt;+ onAuthenticationSuccess(req, res, auth): void&lt;br&gt;&lt;i&gt;Issues JWT token after successful OAuth2 login&lt;/i&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZB">
          <mxGeometry x="390" y="450" width="340" height="145" as="geometry" />
        </mxCell>

        <!-- ═══ Zone C: Downstream Microservices ═══ -->
        <mxCell id="ZC" value="Downstream Microservices  (Servlet Filter Chain)" style="swimlane;startSize=28;fillColor=#FDEBD0;strokeColor=#D35400;fontColor=#7E5109;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1560" height="185" as="geometry" />
        </mxCell>

        <mxCell id="DS_GatewayFilter" value="&lt;b&gt;GatewayAuthenticationFilter&lt;/b&gt;&lt;hr&gt;extends OncePerRequestFilter&lt;br&gt;- validates &quot;X-Gateway-Auth&quot; header&lt;br&gt;+ doFilterInternal(req, res, chain): void&lt;br&gt;&lt;i&gt;Rejects requests not forwarded by gateway&lt;/i&gt;" style="text;html=1;strokeColor=#D35400;fillColor=#FDEBD0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="ZC">
          <mxGeometry x="60" y="38" width="320" height="130" as="geometry" />
        </mxCell>

        <!-- ═══ L_Infra: Infrastructure Layer ═══ -->
        <mxCell id="LI" value="Infrastructure Layer" style="swimlane;startSize=28;fillColor=#F2F3F4;strokeColor=#566573;fontColor=#2C3E50;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1235" width="1560" height="200" as="geometry" />
        </mxCell>

        <mxCell id="I_Redis" value="Redis&#xa;Token Blacklist" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#DC382D;strokeColor=#A01E1E;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="LI">
          <mxGeometry x="80" y="40" width="155" height="135" as="geometry" />
        </mxCell>

        <mxCell id="I_JWT" value="JWT / JJWT Library&#xa;HS256 signed tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontColor=#000000;fontStyle=1;fontSize=12;arcSize=20;" vertex="1" parent="LI">
          <mxGeometry x="330" y="55" width="195" height="90" as="geometry" />
        </mxCell>

        <mxCell id="I_BCrypt" value="BCrypt&#xa;Password hashing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#7D3C98;fontColor=#4A235A;fontStyle=0;fontSize=11;arcSize=20;" vertex="1" parent="LI">
          <mxGeometry x="600" y="55" width="185" height="90" as="geometry" />
        </mxCell>

        <mxCell id="I_OAuth2" value="OAuth2 / Google&#xa;Social login provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;fontStyle=0;fontSize=11;arcSize=20;" vertex="1" parent="LI">
          <mxGeometry x="860" y="55" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- ═══ Cross-zone edges ═══ -->
        <mxCell id="ce1" value="uses" style="dashed=1;endArrow=open;endFill=0;strokeColor=#2E86C1;" edge="1" parent="1" source="JwtAuthFilter_us" target="JwtService_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" value="checks blacklist" style="dashed=1;endArrow=open;endFill=0;strokeColor=#DC382D;" edge="1" parent="1" source="JwtAuthFilter_us" target="TokenBlacklist_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" value="uses" style="dashed=1;endArrow=open;endFill=0;strokeColor=#2E86C1;" edge="1" parent="1" source="JwtAuthzFilter" target="JwtService_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" value="configures filters" style="dashed=1;endArrow=open;endFill=0;strokeColor=#2E86C1;" edge="1" parent="1" source="SecurityConfig" target="JwtAuthFilter_us">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce5" value="issues JWT" style="endArrow=open;endFill=0;strokeColor=#D6B656;" edge="1" parent="1" source="OAuth2SuccessHandler" target="JwtService_if">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce6" value="stores in Redis" style="endArrow=open;endFill=0;strokeColor=#DC382D;" edge="1" parent="1" source="TokenBlacklistImpl" target="I_Redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce7" value="validates" style="endArrow=open;endFill=0;strokeColor=#D6B656;" edge="1" parent="1" source="JwtServiceImpl" target="I_JWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce8" value="validates" style="endArrow=open;endFill=0;strokeColor=#D6B656;" edge="1" parent="1" source="GW_JwtAuthFilter" target="I_JWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce9" value="forwards (with header)" style="endArrow=open;endFill=0;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="GW_JwtAuthFilter" target="DS_GatewayFilter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;──▷  uses / depends on&lt;br&gt;╌╌▷  implements / forwards&lt;br&gt;Zones: Gateway → User Svc → Downstream" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FAFAFA;align=left;verticalAlign=top;spacingLeft=6;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1380" y="80" width="200" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
