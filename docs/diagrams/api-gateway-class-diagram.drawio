<mxfile host="app.diagrams.net">
  <diagram name="API Gateway Class Diagram">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1100" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="API Gateway — Class Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="800" height="45" as="geometry" />
        </mxCell>

        <!-- ═══ L1: Filter / Middleware Layer ═══ -->
        <mxCell id="L1" value="Filter / Middleware Layer  (Spring Cloud Gateway Filters)" style="swimlane;startSize=28;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1560" height="255" as="geometry" />
        </mxCell>

        <mxCell id="JwtAuthFilter" value="&lt;b&gt;JwtAuthFilter&lt;/b&gt;&lt;hr&gt;implements GlobalFilter, Ordered&lt;br&gt;&lt;br&gt;- jwtSecret: String&lt;br&gt;- excludedPaths: List&lt;String&gt;&lt;br&gt;&lt;br&gt;+ filter(exchange, chain): Mono&lt;Void&gt;&lt;br&gt;+ getOrder(): int&lt;br&gt;- validateToken(token): Claims&lt;br&gt;- extractUserDetails(claims): void&lt;br&gt;- isExcluded(path): boolean&lt;br&gt;&lt;br&gt;&lt;i&gt;Validates JWT on every inbound request&lt;/i&gt;" style="text;html=1;strokeColor=#666666;fillColor=#F5F5F5;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="60" y="38" width="340" height="195" as="geometry" />
        </mxCell>

        <mxCell id="GatewayOpenApiConfig" value="&lt;b&gt;GatewayOpenApiConfig&lt;/b&gt;&lt;hr&gt;@Configuration&lt;br&gt;&lt;br&gt;+ customOpenAPI(): OpenAPI&lt;br&gt;+ groupedOpenApi(): GroupedOpenApi&lt;br&gt;&lt;br&gt;&lt;i&gt;Aggregates Swagger docs from all&lt;br&gt;downstream services via SpringDoc&lt;/i&gt;" style="text;html=1;strokeColor=#666666;fillColor=#F5F5F5;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L1">
          <mxGeometry x="460" y="38" width="290" height="175" as="geometry" />
        </mxCell>

        <!-- ═══ L2: DTOs ═══ -->
        <mxCell id="L2" value="Shared DTOs" style="swimlane;startSize=28;fillColor=#EBF5FB;strokeColor=#2E86C1;fontColor=#1A5276;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="345" width="1560" height="185" as="geometry" />
        </mxCell>

        <mxCell id="BaseResponse" value="&lt;b&gt;BaseResponse&lt;T&gt;&lt;/b&gt;  (record)&lt;hr&gt;+ success: boolean&lt;br&gt;+ message: String&lt;br&gt;+ data: T&lt;br&gt;+ timestamp: Instant&lt;br&gt;&lt;br&gt;static ok(data): BaseResponse&lt;T&gt;&lt;br&gt;static error(msg): BaseResponse&lt;T&gt;" style="text;html=1;strokeColor=#2E86C1;fillColor=#EBF5FB;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;rounded=1;" vertex="1" parent="L2">
          <mxGeometry x="60" y="38" width="290" height="125" as="geometry" />
        </mxCell>

        <!-- ═══ L3: Route Configuration ═══ -->
        <mxCell id="L3" value="Route Configuration  (application.yml)" style="swimlane;startSize=28;fillColor=#FEFDE0;strokeColor=#D4AC0D;fontColor=#7D6608;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="550" width="1560" height="220" as="geometry" />
        </mxCell>

        <mxCell id="RouteTable" value="&lt;b&gt;Gateway Route Table&lt;/b&gt;&lt;hr&gt;&lt;table width=&quot;100%&quot;&gt;&lt;tr&gt;&lt;th&gt;Route ID&lt;/th&gt;&lt;th&gt;URI&lt;/th&gt;&lt;th&gt;Predicates&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;user-service&lt;/td&gt;&lt;td&gt;lb://user-service&lt;/td&gt;&lt;td&gt;/api/auth/**&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;order-service&lt;/td&gt;&lt;td&gt;lb://order-service&lt;/td&gt;&lt;td&gt;/api/orders/**&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;menu-service&lt;/td&gt;&lt;td&gt;lb://menu-service&lt;/td&gt;&lt;td&gt;/api/menu/**&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;branch-service&lt;/td&gt;&lt;td&gt;lb://branch-service&lt;/td&gt;&lt;td&gt;/api/branches/**&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;kitchen-service&lt;/td&gt;&lt;td&gt;lb://kitchen-service&lt;/td&gt;&lt;td&gt;/api/kitchen/**&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;analytics-service&lt;/td&gt;&lt;td&gt;lb://analytics-service&lt;/td&gt;&lt;td&gt;/api/analytics/**&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=#D4AC0D;fillColor=#FEFDE0;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="L3">
          <mxGeometry x="60" y="30" width="680" height="170" as="geometry" />
        </mxCell>

        <!-- ═══ L4: Infrastructure Layer ═══ -->
        <mxCell id="L4" value="Infrastructure Layer" style="swimlane;startSize=28;fillColor=#F2F3F4;strokeColor=#566573;fontColor=#2C3E50;fontStyle=1;fontSize=11;align=left;spacingLeft=10;collapsible=0;rounded=1;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="1560" height="210" as="geometry" />
        </mxCell>

        <mxCell id="I_Gateway" value="Spring Cloud Gateway&#xa;Reactive routing engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;fontStyle=1;fontSize=12;arcSize=20;" vertex="1" parent="L4">
          <mxGeometry x="80" y="48" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="I_Eureka" value="Eureka Discovery&#xa;Service Registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#000000;fontStyle=1;fontSize=12;arcSize=20;" vertex="1" parent="L4">
          <mxGeometry x="380" y="48" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="I_JWT" value="JWT / JJWT&#xa;Token validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D6B656;fontColor=#000000;fontStyle=1;fontSize=12;arcSize=20;" vertex="1" parent="L4">
          <mxGeometry x="660" y="48" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="I_Downstream" value="Downstream Microservices&#xa;user · order · menu · branch · kitchen · analytics · notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#566573;fontColor=#2C3E50;fontStyle=0;fontSize=10;arcSize=10;" vertex="1" parent="L4">
          <mxGeometry x="930" y="55" width="420" height="80" as="geometry" />
        </mxCell>

        <!-- ═══ Cross-layer edges ═══ -->
        <mxCell id="ce1" value="validates JWT" style="endArrow=open;endFill=0;strokeColor=#D6B656;" edge="1" parent="1" source="JwtAuthFilter" target="I_JWT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" value="routes via" style="endArrow=open;endFill=0;strokeColor=#82B366;" edge="1" parent="1" source="JwtAuthFilter" target="I_Gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" value="resolves lb://" style="endArrow=open;endFill=0;strokeColor=#6C8EBF;" edge="1" parent="1" source="I_Gateway" target="I_Eureka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" value="forwards to" style="endArrow=open;endFill=0;strokeColor=#566573;" edge="1" parent="1" source="I_Gateway" target="I_Downstream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;──▷  uses / routes to&lt;br&gt;╌╌▷  implements (interface)&lt;br&gt;lb://  load-balanced URI" style="text;html=1;strokeColor=#AAAAAA;fillColor=#FAFAFA;align=left;verticalAlign=top;spacingLeft=6;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1390" y="80" width="190" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
