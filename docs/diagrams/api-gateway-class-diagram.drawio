    <!-- Request mutation note -->
    <mxCell id="40" value="JWT Claims injected as headers downstream:&#xa;&#xa;Authorization (Bearer) header is REMOVED&#xa;X-User-Id   = claims.subject (UUID)&#xa;X-User-Role = claims.get('role')&#xa;X-User-Email = claims.get('email')&#xa;X-User-BranchId = claims.get('branchId')  [optional]&#xa;&#xa;All downstream services trust these headers&#xa;(only reachable via API gateway)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="620" width="500" height="150" as="geometry" />
    </mxCell>

    <!-- Route configuration note -->
    <mxCell id="50" value="Spring Cloud Gateway Routes (application.yml):&#xa;&#xa;/api/v1/users/**      -&gt;  user-service:8081&#xa;/api/v1/auth/**       -&gt;  user-service:8081&#xa;/api/v1/branches/**   -&gt;  branch-service:8085&#xa;/api/v1/menu/**       -&gt;  menu-service:8082&#xa;/api/v1/orders/**     -&gt;  order-service:8083&#xa;/api/v1/kitchen/**    -&gt;  kitchen-service:8084&#xa;/api/v1/notifications/**  -&gt;  notifications-service:8086&#xa;/api/v1/analytics/**  -&gt;  analytics-report-service:8087&#xa;/ws/**                -&gt;  notifications-service:8086 (WebSocket)&#xa;/ws-notifications/**  -&gt;  notifications-service:8086" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="620" y="430" width="460" height="230" as="geometry" />
    </mxCell>

